---
import {getCollection} from "astro:content";
import {openGraph} from "../config.ts";
import Card from "../components/Card.astro";
import Layout from "../layouts/Layout.astro";
import PostList from "../components/PostList.astro";

const allProjects = await getCollection("projects", (post) => post.data.unlisted !== true);

const gameProjects = allProjects.filter((post) => post.data.category === "game");
const scriptProjects = allProjects.filter((post) => post.data.category === "script");

const toPostProps = (post: typeof allProjects[number]) => ({
	url: `/projects/${post.id}`,
	title: post.data.title,
	description: post.data.description,
	date: post.data.releasedAt,
	image: post.data.image,
});
---
<Layout
	pageTitle={openGraph.projects.pageTitle}
	title={openGraph.projects.title}
	description={openGraph.projects.description}
	image={openGraph.projects.image}
	pagefindIgnore
>
	<div class="layout-grid__left" slot="left">
		<Card title="Stats" icon="lucide/chart-column">
			<div class="stat-list">
				<div class="stat">
					<h3 class="stat__number">{gameProjects.length}</h3>
					<span class="stat__label">game project{gameProjects.length === 1 ? '' : 's'}</span>
				</div>
				<div class="stat">
					<h3 class="stat__number">{scriptProjects.length}</h3>
					<span class="stat__label">script project{scriptProjects.length === 1 ? '' : 's'}</span>
				</div>
			</div>
		</Card>
	</div>
	<div class="layout-grid__right" slot="right">
		<Card title="Game projects" icon="lucide/gamepad-2" id="game-projects-card">
			{gameProjects.length > 0
				? <PostList posts={gameProjects.map(toPostProps)} />
				: <p class="empty-message">No game projects yet.</p>}
		</Card>
		<Card title="Script projects" icon="lucide/code-xml" id="script-projects-card">
			{scriptProjects.length > 0
				? <PostList posts={scriptProjects.map(toPostProps)} />
				: <p class="empty-message">No script projects yet.</p>}
		</Card>
	</div>
</Layout>

<style>
	.empty-message {
		margin: 0;
		color: var(--color-subtext0);
	}

	.stat-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.stat {
		display: flex;
		flex-direction: column;
	}

    .stat__number {
        font-size: 2em;
        margin: 0 0 0.5rem;
		color: var(--color-accent);
    }

    .stat__label {
        color: var(--color-text);
    }
</style>